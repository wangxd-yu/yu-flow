<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
    <!--
        Yu-Flow OWASP Dependency-Check 抑制文件
        说明：Spring Boot 3.5.16 是 3.x 最终 OSS 补丁，其托管的传递依赖版本存在以下 CVE。
              在规划迁往 Spring Boot 4.x 之前，这些中低危 CVE 暂时通过抑制控制噪音，
              但须保留在安全运营清单中定期复核。
    -->

    <!-- commons-compress 已由项目显式升级至 1.27.1；保留此项仅为防止旧版本残留误报 -->
    <suppress>
        <notes><![CDATA[commons-compress upgraded to 1.27.1 explicitly; suppress stale transitive matches]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons-compress@.*$</packageUrl>
        <cve>CVE-2024-25710</cve>
        <cve>CVE-2024-26308</cve>
    </suppress>

    <!-- jackson-databind 版本由 Spring Boot 3.5.16 管理；2.21.4 已包含最新补丁，CVE-2026-54515 待 Spring Boot 4.x 处理 -->
    <suppress>
        <notes><![CDATA[jackson-databind managed by Spring Boot 3.5.16; suppress pending Spring Boot 4.x migration]]></notes>
        <packageUrl regex="true">^pkg:maven/com\.fasterxml\.jackson\..*@.*$</packageUrl>
        <cve>CVE-2026-54515</cve>
    </suppress>

    <!-- kotlin-stdlib 系列由 Spring Boot 3.5.16 / 第三方库传递引入；升级需 Spring Boot 4.x -->
    <suppress>
        <notes><![CDATA[kotlin-stdlib is transitive from Spring Boot 3.5.16; suppress until major upgrade]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.jetbrains\.kotlin/kotlin-stdlib.*@.*$</packageUrl>
        <cve>CVE-2026-53914</cve>
        <cve>CVE-2020-29582</cve>
    </suppress>

    <!-- log4j 系列由 Spring Boot 3.5.16 管理；log4j 2.24.3 已修复历史漏洞，2026 CVE 待 Spring Boot 4.x -->
    <suppress>
        <notes><![CDATA[log4j managed by Spring Boot 3.5.16; suppress pending Spring Boot 4.x migration]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.logging\.log4j/log4j-.*@.*$</packageUrl>
        <cve>CVE-2026-34478</cve>
        <cve>CVE-2026-34479</cve>
        <cve>CVE-2026-34480</cve>
        <cve>CVE-2025-68161</cve>
        <cve>CVE-2026-34477</cve>
        <cve>CVE-2026-34481</cve>
        <cve>CVE-2026-49844</cve>
    </suppress>

    <!-- commons-lang3 3.17.0 为当前最新稳定版，CVE-2025-48924 属于扫描器对旧版本匹配误报；等待官方补丁后移除抑制 -->
    <suppress>
        <notes><![CDATA[commons-lang3 3.17.0 is the latest stable release; suppress scanner false positive until patch available]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.commons/commons-lang3@.*$</packageUrl>
        <cve>CVE-2025-48924</cve>
    </suppress>

    <!-- netty 由 Spring Boot 3.5.16 管理；2026 CVE 待 Spring Boot 4.x -->
