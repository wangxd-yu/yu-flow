        <notes><![CDATA[netty managed by Spring Boot 3.5.16; suppress pending Spring Boot 4.x migration]]></notes>
        <packageUrl regex="true">^pkg:maven/io\.netty/netty-.*@.*$</packageUrl>
        <cve>CVE-2026-44891</cve>
        <cve>CVE-2026-55831</cve>
        <cve>CVE-2026-55833</cve>
    </suppress>

    <!-- poi 已由 pom.xml 显式升级至 5.4.0（CVE-2025-31672 已修复）；保留此项仅为防止旧版本残留误报 -->
    <suppress>
        <notes><![CDATA[poi upgraded to 5.4.0 explicitly; suppress stale transitive matches]]></notes>
        <packageUrl regex="true">^pkg:maven/org\.apache\.poi/poi@.*$</packageUrl>
