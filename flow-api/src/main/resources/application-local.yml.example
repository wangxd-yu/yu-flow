# 复制为 application-local.yml（已在 .gitignore；勿提交真实口令）
# 或改用环境变量：SPRING_DATASOURCE_PASSWORD / YU_FLOW_JWT_SECRET / YU_FLOW_AES_SECRET / YU_FLOW_ADMIN_PASSWORD
#
# IDEA：Run Configuration → Active profiles 填 local（不要填 -D...）
spring:
  datasource:
    password: your-mysql-password

yu:
  flow:
    password: change-me-admin-password
    # 本地验收「同名拦截 / WRAP」需要宿主演示接口 /yu-demo/**；生产默认关闭
    host-demo:
      enabled: true
    security:
      fail-on-insecure-defaults: false
      jwt-secret-key: change-me-jwt-secret-at-least-32-chars!!
      # AES 必须正好 16 / 24 / 32 字节（UTF-8 字符数）；下面为 16 字符示例
      aes-secret-key: change-me-aes16!
      # 登录 SM2（可选）：多节点时用同一对 hex；留空则每进程临时生成
      # sm2-private-key: <64-hex-D>
      # sm2-public-key: <130-hex-04XY>
      allow-yml-admin-fallback: true
      # 本地调试 HttpRequest 访问私网时可保持 false；生产默认 true
      block-private-outbound: false
      # 本地联调可放开接口 authMode=NONE；生产默认 false（禁止匿名可调）
      allow-ingress-auth-none: true
      # 本地放开全部脚本语言；生产默认仅 aviator,spel,javascript
      script-allowed-languages: aviator,spel,javascript,groovy,python
    privacy:
      # 库内密文 SM4：16 字节明文或 32 位 hex；未配置则 *_encrypt 失败关闭为 ****
      # at-rest-sm4-key: change-me-sm4-16
