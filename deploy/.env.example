# 复制为 deploy/.env 后填写。deploy/.env 已被 git 忽略，不要提交。
# 生成示例（Git Bash / Linux / macOS）：
#   openssl rand -base64 24     # 数据库口令、管理员口令
#   openssl rand -base64 48     # JWT（至少 32 字符）
#   openssl rand -hex 8         # AES（恰好 16 个十六进制字符）
# 口令不要包含双引号、反斜杠或换行。

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=flow

# 宿主机端口。本机已占用 3306 / 6379 / 11281 时改成别的
MYSQL_PORT=3306
REDIS_PORT=6379
FLOW_PORT=11281

YU_FLOW_ADMIN_USERNAME=admin
YU_FLOW_ADMIN_PASSWORD=
# 至少 32 字符
YU_FLOW_JWT_SECRET=
# 恰好 16、24 或 32 个字符
YU_FLOW_AES_SECRET=

# 本实例环境：DEV / STAGING / PROD。试用保持 DEV
YU_FLOW_CURRENT_ENV=DEV
# 访问 /flow/actuator/prometheus 的 Bearer 令牌。留空则该端点返回 404，health 不受影响
YU_FLOW_METRICS_TOKEN=

# 可选，整体替换容器里的默认 JVM 参数
# JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
